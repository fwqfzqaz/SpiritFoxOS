#!/bin/sh
# SpiritFoxOS musl-gcc 交叉编译包装器
# 使用 musl libc 和 SpiritFoxOS sysroot 进行编译
set -eu
PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
SYSROOT=${SPIRITFOX_SYSROOT:-"$PROJECT_ROOT/build/sysroot"}
SPECS="$SYSROOT/usr/lib/musl-gcc.specs"
if [ ! -f "$SPECS" ]; then
    echo 'musl toolchain missing: run bash tools/bootstrap-deps.sh' >&2
    exit 1
fi
exec "${SPIRITFOX_HOST_CC:-gcc}" -specs "$SPECS" -Wl,--dynamic-linker=/lib/ld-musl-x86_64.so.1 "$@"
