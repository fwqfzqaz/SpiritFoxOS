#!/usr/bin/env bash
set -euo pipefail
integration=0
handoff=0
while IFS= read -r -d '' path; do
    case "$path" in
        docs/integration/*.md) integration=1 ;;
        docs/handoff/NEXT.md) handoff=1 ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [[ "$integration" != 1 || "$handoff" != 1 ]]; then
    echo "Commit blocked: stage this change's docs/integration/*.md and docs/handoff/NEXT.md." >&2
    exit 1
fi
if [[ -z "$(git show :docs/handoff/NEXT.md)" ]]; then
    echo 'Commit blocked: the staged handoff document is empty.' >&2
    exit 1
fi
