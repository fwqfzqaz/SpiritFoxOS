        },
        "requested_caps": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}(?![\\s\\S])"
          }
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory"
          ],
          "properties": {
            "memory": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            }
          }
        },
        "native_profile": {
          "type": "string",
          "minLength": 9,
          "maxLength": 11,
          "enum": [
            "static-v1"
          ]
        },
        "module_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}(?![\\s\\S])"
        },
        "category": {
          "type": "string",
          "minLength": 6,
          "maxLength": 9,
          "enum": [
            "bootstrap",
            "driver",
            "service",
            "runtime"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id",
        "version",
        "runtime_id",
        "app_abi",
        "requested_caps",
        "resource_limits"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])\\.(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])\\.(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])(?![\\s\\S])"
        },
        "requested_caps": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}(?![\\s\\S])"
          }
        },
        "resource_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory"
          ],
          "properties": {
            "memory": {
              "type": "integer",
              "minimum": 1,
              "maximum": 33554432
            }
          }
        },
        "native_profile": {
          "type": "string",
          "minLength": 9,
          "maxLength": 11,
          "enum": [
            "static-v1",
            "relative-v1"
          ]
        },
        "app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}(?![\\s\\S])"
        },
        "runtime_id": {
          "type": "string",
          "minLength": 20,
          "maxLength": 20,
          "const": "org.spiritfox.native"
        },
